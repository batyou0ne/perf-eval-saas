# For running the backend directly on the host (outside Docker Compose).
# Inside Docker Compose, DATABASE_URL/REDIS_URL are set by docker-compose.yml instead,
# using the postgres/redis service names as hostnames.

DATABASE_URL=postgresql+asyncpg://performance_eval:changeme@localhost:5433/performance_eval
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-latest

# Leave RESEND_API_KEY blank to fall back to printing invite/reset links to the
# console instead of sending real email (this is the default local dev setup).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

CORS_ORIGINS=http://localhost:5174
ENVIRONMENT=development

# Token/link lifetimes (defaults shown; usually fine to leave unset).
# INVITE_EXPIRE_DAYS=7
# PASSWORD_RESET_EXPIRE_MINUTES=60

# Required in production (build fails at startup otherwise) — used to build
# invite/reset links. Defaults to the local frontend origin.
FRONTEND_URL=http://localhost:5174
