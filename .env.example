# Postgres
POSTGRES_USER=performance_eval
POSTGRES_PASSWORD=changeme
POSTGRES_DB=performance_eval

# Backend
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
GEMINI_API_KEY=your-key-here
CORS_ORIGINS=http://localhost:5174
ENVIRONMENT=development

# Leave blank to print invite/password-reset links to the backend console
# instead of sending real email (default, no signup needed). See README's
# "Email sending" section for the free Resend setup.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Frontend — only used inside docker-compose.yml itself (proxy target for the
# Vite dev server, via the "backend" service name). Not read from this file.
